rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /connectionTests/{document} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /settings/{document} {
      allow read, write: if true;
    }

    match /clouds/{cloudId} {
      allow read, write: if true;

      match /words/{wordId} {
        allow read: if true;
        allow write: if false;
      }

      match /newWords/{wordId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['text', 'normalized', 'status', 'deviceId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'normalized', 'status', 'deviceId', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.normalized is string
          && request.resource.data.normalized.size() > 0
          && request.resource.data.normalized.size() <= 4000
          && request.resource.data.status == 'pending'
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 200;
        allow update, delete: if false;
      }

      match /operations/{operationId} {
        allow read, write: if false;
      }

      match /wordNormalizationLocks/{lockId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
